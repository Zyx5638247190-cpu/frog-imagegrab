{
  "manifest_version": 3,
  "name": "奶龙取图 / DragonGrab",
  "version": "1.1.0",
  "description": "嗷！奶龙帮你一键提取淘宝/天猫/京东/拼多多商家版商品详情页的所有图片，集中展示、勾选后批量下载为 PNG / JPG / WebP，支持打包 ZIP、相似图合并、大图预览。",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "奶龙取图：打开图库（Alt+S 直接提取当前页）",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "clipboardWrite",
    "tabs"
  ],

  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.jd.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*",

    "*://*.alicdn.com/*",
    "*://*.taobaocdn.com/*",
    "*://*.tbcdn.cn/*",
    "*://*.360buyimg.com/*",
    "*://*.360buycdn.com/*",
    "*://*.jdimg.com/*",
    "*://*.pddpic.com/*",
    "*://*.pddcdn.com/*",
    "*://*.pddugc.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "commands": {
    "dragon-extract": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "奶龙取图：提取当前页面所有商品图片"
    }
  },

  "minimum_chrome_version": "102"
}
